{
	admin :2019
	email ajhalili2006@tuta.io

	# use Storj DCS for storing SSL keys via S3 API
	storage s3 {
		host "gateway.storjshare.io"
		bucket "docker-mounts"
		access_id {$STORJ_DCS_GATEWAY_ACCESS_ID}
		secret_key {$STORJ_DCS_GATEWAY_ACCESS_SECRET}
		prefix "caddy/localdev"
	}
}

{$TAILSCALE_HOSTNAME}.{$TAILSCALE_TLS_SUBDOMAIN}.ts.net {
	respond "Hello world!"
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}

*.localdev.andreijiroh.dev localdev.andreijiroh.dev {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	respond "Hello world!"
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}

	@keycloak host sso.localdev.andreijiroh.dev
	handle @keycloak {
		reverse_proxy keycloak-lab:8080
	}
	@wplab host wp.localdev.andreijiroh.dev
	handle @wplab {
		reverse_proxy wordpress:80
	}
	@pma host pma.localdev.andreijiroh.dev
	handle @pma {
		reverse_proxy phpmyadmin:80 {
			header_up Host {host} # redundant
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote} # redundant
			header_up X-Forwarded-Port {server_port} # redundant
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

*.wplabs.andreijiroh.dev wplabs.andreijiroh.dev {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy wordpress:80
}

*.stellapent.tailnet.andreijiroh.dev stellapent.tailnet.andreijiroh.dev {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	respond "Hello world!"
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}

	@keycloak host sso.stellapent.tailnet.andreijiroh.dev
	handle @keycloak {
		reverse_proxy keycloak-lab:8080
	}

	@wplab host wp.stellapent.tailnet.andreijiroh.dev
	handle @wplab {
		reverse_proxy wordpress:80
	}

	@code host code.stellapent.tailnet.andreijiroh.dev
	handle @code {
		reverse_proxy host.docker.internal:4208
	}
}

# proxy to local port of docker host from caddy container
*.proxykit.localdev.andreijiroh.dev *.proxykit.localdev.andreijiroh.xyz {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy host.docker.internal:{labels.4}

	handle_errors {
		respond "Local server at port {labels.4} failed with error: {err.status_code} {err.status_text}"
	}
}

*.proxykit.stellapent.tailnet.andreijiroh.dev *.proxykit.stellapent.tailnet.andreijiroh.xyz {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy host.docker.internal:{labels.5}

	handle_errors {
		respond "Local server at port {labels.5} failed with error: {err.status_code} {err.status_text}"
	}
}
